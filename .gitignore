# ============================================================================
# ORBITWATCH .gitignore
# ============================================================================

# Dependencies
node_modules/
server/node_modules/
client/node_modules/

# Production Build Outputs
client/dist/
server/dist/
dist/
build/

# Environment Variables & Secrets (Keep .env.example tracked)
.env
.env.local
.env.*.local
*.env
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS Generated Files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor Files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Testing & Coverage
coverage/
.nyc_output/

# Database Dumps (Ignore dynamic SQL backups; retain the offline fallback JSON snapshot)
scripts/snapshots/*.sql
!scripts/snapshots/latest_snapshot.json
